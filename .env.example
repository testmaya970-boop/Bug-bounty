# Optional. Defaults to "dev" (the built-in simulated provider -- safe for local/test use,
# never sends real email) when unset. Set to "resend" only when RESEND_API_KEY and
# EMAIL_FROM below are both also set -- see lib/email-provider.ts and
# docs/decisions/0022-real-email-provider-integration.md.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=noreply@your-verified-domain.example

# Optional, but a real launch blocker if left unset in production: defaults to
# "http://localhost:3000" (see actions/program-researchers.ts), which would make every
# program-researcher-invitation email link to localhost instead of the real deployed URL.
# Set to the actual production origin before launch.

# Native Postgres migration. Standalone Postgres connection string (not Supabase-managed).
# MUST be a plain, non-superuser, non-BYPASSRLS role (see db/init/01-app-role.sql and
# lib/db/pool.ts's setActorClaims) -- a superuser connection silently bypasses RLS
# regardless of any SET ROLE the app performs, defeating the RLS-as-defense-in-depth
# design this migration relies on. See lib/db/pool.ts, lib/env.ts. Local dev:
# docker-compose.native.yml provisions sentinel_app_runtime for exactly this purpose.
DATABASE_URL=postgres://sentinel_app_runtime:your-password@localhost:55432/sentinel

# Schema owner, used ONLY by `npm run db:migrate` (DDL needs the owner; the runtime role
# above deliberately cannot). Never give this to the app itself. Local dev: the
# docker-compose.native.yml bootstrap user.
MIGRATION_DATABASE_URL=postgres://sentinel_app:your-password@localhost:55432/sentinel

# Backups (scripts/db-backup.mjs: npm run db:backup / db:restore / db:backup:verify) use
# pg_dump/pg_restore from PATH. Where they only exist inside the database container (local
# docker-compose.native.yml), set this and they run via `docker exec` instead.
# PG_DOCKER_CONTAINER=sentinel_native_postgres
# BACKUP_DIR=backups
# BACKUP_KEEP=14

# Derives every CTF flag (lib/ctf-flags.ts). Every environment must share the value the
# committed artifacts and flag hashes were generated with -- get it from the team's secret
# store; never commit it. Only build scripts and the E2E suite read it, never the app.
CTF_FLAG_SECRET=

# The app's public origin. Every emailed link and auth redirect is built from this,
# never from request headers. Must be https in production.
APP_ORIGIN=http://localhost:3000

# Signs/validates the opaque session cookie (lib/auth/session.ts). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=your-32-plus-byte-random-secret

# S3-compatible object storage for evidence files (lib/evidence-store.ts's
# s3EvidenceObjectStore). Local dev: docker-compose.native.yml's MinIO service, with
# S3_FORCE_PATH_STYLE=true (MinIO/most non-AWS S3-compatible endpoints need this).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidence
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=true
#
# Report attachments upload from the BROWSER straight to this bucket under a signed PUT
# (services/evidence-uploads.ts), so S3_ENDPOINT must be reachable by users' browsers and the
# bucket must allow CORS PUT from APP_ORIGIN (MinIO allows any origin by default; on S3 add a
# CORS rule for PUT with the Content-Type header). Limits, enforced when signing and again
# when verifying the stored file (the database's hard ceiling is 1024 MB):
# EVIDENCE_MAX_FILE_MB=50
# EVIDENCE_MAX_FILES=20

# Where organizations send money to fund their prepaid balance (services/billing.ts).
# Unpatched's own receiving accounts; shown in Payments -> Add funds. Leave a currency
# blank and the dialog tells the organization to ask support for the details instead.
# FUNDING_INR_ACCOUNT_NAME=
# FUNDING_INR_ACCOUNT_NUMBER=
# FUNDING_INR_IFSC=
# FUNDING_INR_UPI_ID=
# FUNDING_USD_ACCOUNT_NAME=
# FUNDING_USD_BANK_NAME=
# FUNDING_USD_ACCOUNT_NUMBER=
# FUNDING_USD_ROUTING=
# FUNDING_USD_SWIFT=

# Card top-ups of the prepaid balance (lib/integrations/card.ts): none | sandbox | razorpay
# (INR) / stripe (USD). The provider hosts the card form; only its signed webhook confirms.
# Webhook URLs: <APP_ORIGIN>/api/webhooks/card/razorpay and /api/webhooks/card/stripe.
# CARD_PROVIDER_IN=none
# CARD_PROVIDER_GLOBAL=none
# CARD_SURCHARGE_BPS=300            # card fee passed on, in basis points (300 = 3%)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# The entity on GST invoices for the platform fee (Platform -> Payouts -> Fee invoices).
# Confirm the GST treatment and SAC with your CA before issuing real invoices. Off
# production an unset seller issues clearly marked SANDBOX invoices.
# INVOICE_SELLER_NAME=
# INVOICE_SELLER_GSTIN=
# INVOICE_SELLER_ADDRESS=
# INVOICE_SELLER_STATE_CODE=        # 2-digit GST state code, e.g. 29 (Karnataka)
# INVOICE_SAC_CODE=
