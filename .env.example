# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional database & object store overrides (defaults to built-in mock database & store)
DATABASE_URL="postgres://sentinel_app:sentinel_dev_password@localhost:55432/sentinel"
SESSION_SECRET_PEPPER="dev-only-session-pepper-change-in-production-32chars"
EVIDENCE_S3_ENDPOINT="http://localhost:9000"
EVIDENCE_S3_REGION="us-east-1"
EVIDENCE_S3_BUCKET="unpatched-evidence"
EVIDENCE_S3_ACCESS_KEY_ID="minioadmin"
EVIDENCE_S3_SECRET_ACCESS_KEY="minioadmin"
