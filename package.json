{
  "name": "unpatched-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "ctf:artifacts": "tsx --env-file=.env.local scripts/ctf-artifacts/generate.mjs",
    "ctf:artifacts:verify": "tsx --env-file=.env.local scripts/ctf-artifacts/generate.mjs --verify",
    "worker:outbox": "tsx --env-file=.env.local workers/outbox/run.ts",
    "worker:alias-mail": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local workers/alias-mail/run.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/run-native-migrations.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs backup",
    "db:restore": "node --env-file-if-exists=.env.local scripts/db-backup.mjs restore",
    "db:backup:verify": "node --env-file-if-exists=.env.local scripts/db-backup.mjs verify",
    "db:backup:check": "node --env-file-if-exists=.env.local scripts/db-backup.mjs check",
    "storage:init": "node --env-file-if-exists=.env.local scripts/storage-init.mjs",
    "release": "node --env-file-if-exists=.env.local scripts/release.mjs release",
    "start:prod": "node --env-file-if-exists=.env.local scripts/release.mjs start",
    "rollback": "node scripts/release.mjs rollback",
    "releases": "node scripts/release.mjs list",
    "check:rpc-args": "node --env-file-if-exists=.env.local scripts/check-rpc-call-order.mjs",
    "check:authz": "node --env-file-if-exists=.env.local scripts/check-authz-catalog.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:showcase": "tsx --env-file=.env.local scripts/seed-showcase.ts",
    "seed:launch": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:e2e": "tsx --env-file=.env.local scripts/seed-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "imapflow": "^2.2.11",
    "lenis": "^1.3.26",
    "mailparser": "^3.9.37",
    "next": "^16.3.6",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
